# Host directories. Relative paths are resolved from compose.yaml.
CURE_NGS_INPUT_DIR=./examples
CURE_NGS_OUTPUT_DIR=./workspace/output
CURE_NGS_REFERENCE_DIR=./references

# The image defaults to its non-root account. Linux users may set these to the
# output of `id -u` and `id -g` when bind-mount permissions require it.
CURE_NGS_UID=10001
CURE_NGS_GID=10001
